generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           String         @default("ADMIN")
  isActive       Boolean        @default(true)
  isPrimary      Boolean        @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  loginHistories LoginHistory[]
}

model LoginHistory {
  id        String     @id @default(uuid())
  adminId   String?
  email     String
  status    String     // 'SUCCESS' | 'FAILED'
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model Vehicle {
  id                String   @id @default(uuid())
  name              String
  fullTitle         String?
  slug              String   @unique
  tagline           String?
  category          String   // 'PASSENGERS' | 'COMMERCIAL' | 'ELECTRIC'
  subcategory       String?  // 'PICKUP' | 'VAN' | 'TRUCK'
  categoryLabel     String?
  price             Float?
  formattedPrice    String?
  priceLabel        String?
  isPriceOnRequest  Boolean  @default(true)
  status            String   @default("Published") // 'Published' | 'Draft'
  stockStatus       String   @default("in_stock")
  stockQuantity     Int      @default(1)
  isFlagship        Boolean  @default(false)
  isNew             Boolean  @default(false)
  mainImage         String
  heroImage         String?
  altText           String?
  gallery           String   @default("[]") // JSON string array of image URLs
  colorOptions      String   @default("[]") // JSON string array of {name, hex}
  overview          String
  specs             String   @default("{}") // JSON string object of key-value specs
  features          String   @default("[]") // JSON string array of features
  whyT9Benefits     String   @default("[]") // JSON string array of highlights
  warranty          String?
  brochureAvailable Boolean  @default(true)
  brochureUrl       String?
  seoTitle          String?
  metaDescription   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  leads             Lead[]
}

model Lead {
  id           String    @id @default(uuid())
  type         String    // 'TEST_DRIVE' | 'QUOTE' | 'SERVICE' | 'INQUIRY'
  name         String
  email        String
  phone        String
  city         String?
  vehicleId    String?
  preferredDate String?
  message      String?
  status       String    @default("NEW") // 'NEW' | 'CONTACTED' | 'QUALIFIED' | 'CLOSED'
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
}

model PageContent {
  id        String   @id @default(uuid())
  key       String   @unique // 'home' | 'about' | 'services' | 'contact'
  data      String   // JSON string of page content
  updatedAt DateTime @updatedAt
}

model UploadedFile {
  id        String   @id @default(uuid())
  filename  String   @unique
  url       String
  mimeType  String?
  size      Int?
  data      String?  // Base64 buffer content for persistent serverless asset serving
  createdAt DateTime @default(now())
}

model HeroImage {
  id           String   @id @default(uuid())
  url          String
  title        String?
  altText      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String   // 'TikTok' | 'Instagram' | 'Facebook' | 'WhatsApp'
  url          String
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // 'info' | 'lead' | 'system' | 'alert'
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Review {
  id           String   @id @default(uuid())
  customerName String
  avatarUrl    String?
  rating       Int      @default(5)
  reviewText   String
  reviewDate   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model DepartmentContact {
  id            String   @id @default(uuid())
  name          String   @unique
  contactPerson String?
  phone         String
  whatsapp      String?
  email         String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model TeamMember {
  id               String       @id @default(uuid())
  name             String
  designation      String
  department       String
  shortDescription String?
  imageUrl         String?
  parentId         String?
  parent           TeamMember?  @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         TeamMember[] @relation("TeamHierarchy")
  displayOrder     Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}
